# Optional — enables the AI fallback for questions the scripted chat can't answer.
# Without it the site still works; unmatched questions get a local retrieval answer.
ANTHROPIC_API_KEY=

# Optional overrides
# CLAUDE_MODEL=claude-haiku-4-5      # cheapest; swap for claude-sonnet-5 or claude-opus-5 for richer answers
# CHAT_DAILY_CAP=300                 # hard ceiling on AI calls per day (per warm instance)
